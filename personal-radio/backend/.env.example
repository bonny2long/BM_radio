APP_NAME=BM Radio
APP_ENV=development
TZ=America/Chicago

# Local setup uses PostgreSQL 16 in Docker (container bm-radio-postgres-dev,
# loopback only). Put the real password in backend/.env, never in Git.
BM_RADIO_DB_URL=postgresql+psycopg://bm_radio_app:<password>@127.0.0.1:55432/bm_radio
# Throwaway development only (SQLite is refused when APP_ENV is production-like):
# BM_RADIO_DB_URL=sqlite:///./bm_radio.db

# Final libraries, read-only. Never point these at _INGEST, _STAGING or _QUARANTINE.
BM_RADIO_MUSIC_ROOT=C:/NAS-Local/nas-data/Music
BM_RADIO_AUDIOBOOK_ROOT=C:/NAS-Local/nas-data/Audiobooks/Library
BM_RADIO_BOOK_ROOT=C:/NAS-Local/nas-data/Books

BM_RADIO_CACHE_ROOT=C:/NAS-Local/App-State/BM-Radio/cache
BM_RADIO_ARTWORK_CACHE_ROOT=C:/NAS-Local/App-State/BM-Radio/cache/artwork

BM_RADIO_API_HOST=127.0.0.1
BM_RADIO_API_PORT=8094
BM_RADIO_API_DOCS_ENABLED=false
BM_RADIO_CORS_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174"]

BM_RADIO_ENABLE_LEGACY_DISCOGRAPHY_SCAN=false

PUBLIC_ACCESS=false
ALLOW_FILE_MUTATION=false
ALLOW_DELETE=false
ALLOW_TAG_WRITES=false
SCAN_INGEST_FOLDERS=false
